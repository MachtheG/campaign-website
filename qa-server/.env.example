# Core server
PORT=3001
NODE_ENV=production

# JWT and auth
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRY=12h

# Optional: override default users (JSON array with username/passwordHash/role/displayName)
# CAMPAIGN_USERS_JSON=[{"username":"admin","passwordHash":"<sha256>","role":"admin","displayName":"System Admin"}]

# CORS controls
# Set exact frontend domains that can call this backend
CORS_ALLOWED_ORIGINS=https://votemaureen4karen.co.ke,https://www.votemaureen4karen.co.ke
CORS_ALLOW_ALL=false

# SMTP for form delivery
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FORM_FROM=no-reply@votemaureen4karen.co.ke
